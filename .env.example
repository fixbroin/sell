
GEMINI_API_KEY=XXXXXXXXXXXXXXXX


# MySQL Database Configuration (Option A: Connection URL, or Option B: Individual variables)
DATABASE_URL=mysql://yourbrand_db:your_mysql_password@localhost:3306/yourbrand_db
MYSQL_HOST=localhost
MYSQL_DATABASE=yourbrand_db
MYSQL_USER=yourbrand_db
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=XXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_APP_ID=1:XXXXXXXXXX:web:XXXXXXX
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXXXXX

# Base URL for your application (used in sitemap, metadata, etc.)
# Ensure this is set to your production URL for deployment
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PORT=3006
# Google Maps API Key (Optional, if used for map features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"


# Razorpay API Keys (from your Razorpay dashboard)
RAZORPAY_KEY_ID=XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay Webhook Secret (create this in your Razorpay webhook settings)
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXX

FIREBASE_ADMIN_SDK_CONFIG='{XXXXXXXXXXXXXXXXXXXXXXXXXXX
XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
  "
}'


# WhatsApp Webhook Verification Token
# This should be a strong, random string that you also configure in your Meta for Developers App dashboard.

CRON_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX






WHATSAPP_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_PHONE_NUMBER_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token

# System Administrator Configuration
NEXT_PUBLIC_ADMIN_EMAIL=admin@yourdomain.com

# Internal API Secret (Generate a strong 32+ character random string for secure server-side calls)
INTERNAL_API_SECRET=generate_strong_32_char_random_secret_string_here
